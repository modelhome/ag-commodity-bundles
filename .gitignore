# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Model Home runner output
# The Modelfile redirects stdout to run/<output>.output.json; that's per-invocation,
# not source.
run/
*.output.json

# Claude Code local state
# .claude/ itself is committed on purpose: the vendored feat skill lives in
# .claude/skills/feat/. Ignore only machine- or user-specific settings.
.claude/settings.local.json
.claude/*.local.json

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Build download caches. The committed artifacts are the CSV tables the build
# scripts write, not the multi-hundred-megabyte USDA exports they read.
.nass-cache/
.ers-cache/

# Credentials. No bundle here needs a key today -- the USDA bulk exports are
# keyless -- but these belong in the home directory either way. Never commit a
# copy.
.netrc
*.pem
.env
.env.*
